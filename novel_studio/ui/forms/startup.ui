<ui version="4.0"><class>StartupDialog</class><widget class="QDialog" name="StartupDialog"><property name="windowTitle"><string>Novel Studio - 프로젝트 시작</string></property><property name="minimumSize"><size><width>780</width><height>620</height></size></property><layout class="QVBoxLayout" name="root"><item><widget class="QLabel" name="welcome"><property name="text"><string>Novel Studio</string></property></widget></item><item><widget class="QLabel" name="desc"><property name="text"><string>새 작품을 만들거나 기존 작품을 불러와 시작하세요.</string></property></widget></item><item><widget class="QGroupBox" name="newBox"><property name="title"><string>새 프로젝트</string></property><layout class="QFormLayout" name="newForm"><item row="0" column="0"><widget class="QLabel" name="titleLabel"><property name="text"><string>작품명</string></property></widget></item><item row="0" column="1"><widget class="QLineEdit" name="titleEdit"/></item><item row="1" column="0"><widget class="QLabel" name="genreLabel"><property name="text"><string>장르</string></property></widget></item><item row="1" column="1"><widget class="QComboBox" name="genreEdit"><property name="editable"><bool>true</bool></property><item><property name="text"><string>선협</string></property></item><item><property name="text"><string>무협</string></property></item><item><property name="text"><string>판타지</string></property></item><item><property name="text"><string>로맨스</string></property></item><item><property name="text"><string>현대</string></property></item><item><property name="text"><string>스릴러</string></property></item><item><property name="text"><string>호러</string></property></item><item><property name="text"><string>SF</string></property></item><item><property name="text"><string>역사</string></property></item><item><property name="text"><string>게임</string></property></item></widget></item><item row="2" column="0"><widget class="QLabel" name="moodLabel"><property name="text"><string>분위기</string></property></widget></item><item row="2" column="1"><