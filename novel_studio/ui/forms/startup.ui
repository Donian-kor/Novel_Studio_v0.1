        <item row="0" column="1"><widget class="QSpinBox" name="charSpin"><property name="value"><number>5000</number></property><property name="minimum"><number>500</number></property><property name="maximum"><number>30000</number></property><property name="suffix"><string> 자</string></property></widget></item>
        <item row="1" column="0"><widget class="QLabel" name="tolLabel"><property name="text"><string>허용 오차 (±)</string></property></widget></item>
        <item row="1" column="1"><widget class="QSpinBox" name="tolSpin"><property name="value"><number>300</number></property><property name="minimum"><number>0</number></property><property name="maximum"><number>5000</number></property><property name="suffix"><string> 자</string></property></widget></item>
