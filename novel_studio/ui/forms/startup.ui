   <item><layout class="QHBoxLayout" name="actions"><item><widget class="QPushButton" name="createBtn"><property name="text"><string>새 프로젝트 만들기</string></property></widget></item><item><widget class="QPushButton" name="openBtn"><property name="text"><string>기존 프로젝트 불러오기</string></property></widget></item><item><widget class="QPushButton" name="settingsBtn"><property name="text"><string>AI / 편집기 설정</string></property></widget></item><item><widget class="QPushButton" name="exitBtn"><property name="text"><string>종료</string></property></widget></item></layout></item>
